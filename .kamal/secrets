# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be
# safe for git.
#
# Every secret lives in the encrypted credentials (config/credentials.yml.enc, edited with
# bin/rails credentials:edit), so the only thing to keep safe is config/master.key: keep a copy in a password
# manager and never check it into git. DEPLOY.md, part B, lists the credential keys.

# Decrypts the credentials inside the app, which reads admin.* and spaces.* from them itself.
RAILS_MASTER_KEY=$(cat config/master.key)

# A DigitalOcean API token with read and write access to the Container Registry.
KAMAL_REGISTRY_PASSWORD=$(bin/rails credentials:fetch kamal.registry_password)

# The Spaces access key for this project's backups bucket, for the Litestream accessory.
SPACES_ACCESS_KEY_ID=$(bin/rails credentials:fetch spaces.access_key_id)
SPACES_SECRET_ACCESS_KEY=$(bin/rails credentials:fetch spaces.secret_access_key)
