    <div>
      <p class="breadcrumb"><%= link_to t("admin.artworks.index.title"), admin_artworks_path %></p>
      <h1><%= t(".title") %></h1>
    </div>
  </div>

  <p class="page-intro"><%= t(".intro") %></p>

  <%= render "form", artwork: @artwork %>
<% end %>
