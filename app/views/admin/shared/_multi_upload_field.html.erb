<%#
  A file field for several images at once (named images[]). Each file goes straight to Active Storage in its
  own request, with a line of progress; files over the size limit or of the wrong type are dropped first.
  Locals: id, label, hint.
%>
<%= tag.div class: "field image-field", data: admin_upload_data do %>
  <%= label_tag id, label %>
  <p class="hint" id="<%= id %>_hint"><%= hint %> <%= t("admin.images.formats_each", formats: ImageAttachments.format_names, max_megabytes: ImageAttachments::MAX_BYTES / 1.megabyte) %></p>
  <%= file_field_tag "images[]", id: id, multiple: true, accept: admin_image_accept, direct_upload: true,
        data: { upload_target: "input", action: "upload#check" }, aria: { describedby: "#{id}_hint" } %>
  <p class="upload-errors" data-upload-target="errors" role="alert"></p>
  <ul class="uploads" data-upload-target="list" aria-live="polite"></ul>
<% end %>
