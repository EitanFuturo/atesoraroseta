<!DOCTYPE html>
<%# The public site's layout (overview §4.6): no JavaScript, no csrf_meta_tags (they would write the session
    cookie), and the three public stylesheets linked by name, never :app (which would add the admin's). %>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= page_title %></title>
    <%= render "public/meta" %>
    <%= preload_link_tag "jost-normal-latin.woff2" %>
    <%= preload_link_tag "bodoni-moda-normal-latin.woff2" %>
    <%= stylesheet_link_tag "fonts", "site", "layout" %>
  </head>

  <body class="page">
    <div class="container">
      <%= render "public/header" %>
      <%= yield %>
    </div>
  </body>
</html>
